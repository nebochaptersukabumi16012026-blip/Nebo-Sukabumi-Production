<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Blokir seluruh traffic HTTP biasa (cleartext) secara global -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Hanya izinkan domain backend resmi dengan HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">nebosukabumi.net</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
